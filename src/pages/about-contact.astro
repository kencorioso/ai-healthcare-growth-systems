---
// About / Contact — minimal placeholder route.
// Full population (professional bridge copy + contact form) is out of scope
// for this pass; see docs/harbor-ridge-workstream-f-step2-information-architecture.md §3
// and docs/harbor-ridge-workstream-f-step3-content-allocation-matrix.md row 9.
import Layout from '../components/Layout.astro';
---

<Layout title="About / Contact — Ken Corioso | Harbor Ridge V1">
  <main class="placeholder">
    <div class="placeholder__inner">
      <h1>About / Contact</h1>
      <p>
        This page will hold a concise account of Ken, why this project
        connects to his healthcare/growth/AI experience, links to resume,
        LinkedIn, GitHub, case study, and whitepaper, and a contact form
        (Name, Email, Subject, Message).
      </p>
      <p><a href="/">&larr; Back to Home</a></p>
    </div>
  </main>

  <style>
    .placeholder {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-4);
    }

    .placeholder__inner {
      max-width: 70ch;
    }

    .placeholder h1 {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-h1);
      line-height: var(--line-height-heading);
      margin: 0 0 var(--space-4) 0;
    }

    .placeholder a {
      color: var(--color-sovereign-navy);
    }
  </style>
</Layout>
