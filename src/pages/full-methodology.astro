    .taxonomy__item dd {
      margin: 0;
      color: var(--color-slate-text-secondary);
    }

    /* ---------------------------------------------------------------
       Compact $251K figures table — bounded-scroll-container discipline
       transferred from Evidence Trail's claim-level table, applied
       defensively here even though this table is small.
       --------------------------------------------------------------- */
    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--color-slate-border);
      border-radius: 8px;
      margin: 0 0 var(--space-4) 0;
    }

    .figures-table {
      border-collapse: collapse;
      width: 100%;
      min-width: 480px;
      font-size: var(--text-small);
    }

    .figures-table th,
    .figures-table td {
      border-bottom: 1px solid var(--color-slate-border);
      padding: var(--space-2) var(--space-3);
      text-align: left;
      white-space: nowrap;
    }

    .figures-table thead th {
      background: var(--color-steel-gray-surface);
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--color-sovereign-navy);
    }

    .figures-table tbody th {
      font-family: var(--font-heading);
      font-weight: 600;
      color: var(--color-sovereign-navy);
      background: var(--color-white);
    }

    .figures-table td {
      color: var(--color-slate-text-secondary);
      font-variant-numeric: tabular-nums;
      background: var(--color-white);
    }

    .figures-table tbody tr:last-child th,
    .figures-table tbody tr:last-child td {
      border-bottom: none;
    }

    /* ---------------------------------------------------------------
       The Governing Evaluation — dl.reckoning MISS/MISS/CLEAN, the
       exact component already live on Home and Methodology &
       Evaluation: equal visual weight, no color-coding.
       --------------------------------------------------------------- */
    .reckoning {
      display: grid;
      grid-template-columns: 1fr;
      margin: var(--space-6) 0 clamp(var(--space-7), 8vw, var(--space-8)) 0;
      padding: 0;
      border-top: 1px solid var(--color-navy-muted-on-dark);
      border-bottom: 1px solid var(--color-navy-muted-on-dark);
    }

    .reckoning__item {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5) 0;
      border-top: 1px solid var(--color-navy-muted-on-dark);
    }

    .reckoning__item:first-child {
      border-top: none;
    }

    .reckoning__item dt {
      font-family: var(--font-body);
      font-weight: 500;
      font-size: var(--text-small);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-navy-muted-on-dark);
      margin: 0;
    }

    .reckoning__item dd {
      margin: 0;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: clamp(3.5rem, 2.4rem + 6vw, 8rem);
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    @media (min-width: 640px) {
      .reckoning {
        grid-template-columns: repeat(3, 1fr);
        padding: var(--space-6) 0;
        container-type: inline-size;
      }

      .reckoning__item {
        border-top: none;
        padding: 0 var(--space-5);
        border-left: 1px solid var(--color-navy-muted-on-dark);
      }

      .reckoning__item:first-child {
        padding-left: 0;
        border-left: none;
      }

      .reckoning__item dd {
        font-size: clamp(2.5rem, -2.36rem + 14cqi, 8rem);
      }
    }

    /* ---------------------------------------------------------------
       Freezing Ground Truth -> The First Blind Evaluation: both LIGHT
       (spec §4 explicitly approves this adjacency). Editorial
       separation comes from the preceding section's own border-bottom
       (unchanged/default — not suppressed) plus this section's Steel
       Gray Surface tonal band, rather than an arbitrary inserted NAVY
       section.
       --------------------------------------------------------------- */
    .section--surface {
      background: var(--color-steel-gray-surface);
    }

    /* ---------------------------------------------------------------
       Back to Top — simple affordance after the final content section.
       --------------------------------------------------------------- */
    .back-to-top {
      margin: var(--space-6) 0 0 0;
    }

    .back-to-top a {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: var(--text-small);
      color: var(--color-white);
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    /* ---------------------------------------------------------------
       Go Deeper — light-surface variant of the site's index-list
       pattern (this section is LIGHT, per spec §4 row 10), redeclared
       here since Astro scopes CSS per page.
       --------------------------------------------------------------- */
    .section--deeper {
      padding-bottom: clamp(var(--space-8), 10vw, calc(var(--space-8) * 1.2));
      margin-bottom: calc(-1 * var(--space-8));
    }

    .index-list {
      list-style: none;
      margin: var(--space-5) 0 var(--space-4) 0;
      padding: 0;
    }

    .index-list--light .index-list__item {
      border-top: 1px solid var(--color-slate-border);
    }

    .index-list--light .index-list__item:last-child {
      border-bottom: 1px solid var(--color-slate-border);
    }

    .index-list--light .index-list__item a {
      color: var(--color-sovereign-navy);
    }

    .index-list--light .index-list__num,
    .index-list--light .index-list__desc,
    .index-list--light .index-list__arrow {
      color: var(--color-slate-text-secondary);
    }

    .index-list--light .index-list__item a:hover .index-list__arrow,
    .index-list--light .index-list__item a:focus-visible .index-list__arrow {
      color: var(--color-sovereign-navy);
    }

    .index-list__item a {
      display: flex;
      align-items: baseline;
      gap: var(--space-5);
      padding: var(--space-5) 0;
      text-decoration: none;
      min-height: 44px;
    }

    .index-list__num {
      flex-shrink: 0;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: var(--text-h3);
      font-variant-numeric: tabular-nums;
      min-width: 2ch;
    }

    .index-list__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      flex: 1 1 auto;
      min-width: 0;
    }

    .index-list__item a:hover .index-list__title,
    .index-list__item a:focus-visible .index-list__title {
      text-decoration: underline;
    }

    .index-list__title {
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: var(--text-body);
    }

    .index-list__desc {
      font-family: var(--font-body);
      font-size: var(--text-small);
    }

    .index-list__arrow {
      flex-shrink: 0;
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 200ms ease, transform 200ms ease;
    }

    .index-list__item a:hover .index-list__arrow,
    .index-list__item a:focus-visible .index-list__arrow {
      opacity: 1;
      transform: translateX(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .index-list__arrow {
        transition: none !important;
      }
    }
  </style>
</Layout>
